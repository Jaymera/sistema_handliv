# App
APP_ENV=development
APP_SECRET=change_me_to_a_random_64_char_secret_string_here

# CORS: frontend dev url, comma separated
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:19006

# Database
DATABASE_URL=mysql+pymysql://handliv:handliv@db:3306/handliv
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change_me_jwt_secret_random_long_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# Stripe (mode test para dev)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_FREE=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_PREMIUM=price_xxx

# Super Admin bootstrap
ADMIN_NAME=Handliv
ADMIN_EMAIL=admin@handliv.com
ADMIN_USERNAME=Handliv
ADMIN_PASSWORD=samsung12

# SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=app_password_16_chars
SMTP_FROM=no-reply@handliv.com

# Expo Push (only required in production)
EXPO_ACCESS_TOKEN=

# Market data
MARKET_DATA_PROVIDER=yfinance
YFINANCE_FETCH_TIMES=10:00,18:00

# IA / NLP — local libs (no paid token required)
LLM_PROVIDER=disabled
LLM_API_KEY=

# MT5 (Fase 2 — deixe em branco no MVP)
MT5_API_BASE_URL=
MT5_API_TOKEN=

# Uploads / Downloads
UPLOADS_DRIVER=local
UPLOADS_BASE_DIR=./storage/uploads
UPLOADS_MAX_SIZE_MB=100
UPLOADS_ALLOWED_EXT=zip,rar,ex5,mq5,pdf